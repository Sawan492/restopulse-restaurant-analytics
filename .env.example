# Create a real .env file next to package.json and add your own Gemini API key.
# Keep this key private. Never put it in frontend code or commit .env to Git.
GEMINI_API_KEY=

# Current stable model listed in Google's Gemini API model documentation.
GEMINI_MODEL=gemini-3.8-flash

# Optional. The server defaults to 8787 in development and uses the PORT set by Render/Cloud Run in production.
PORT=8787
